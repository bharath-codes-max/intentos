# Intentos API (Fastify backend) environment variables.
# Copy to .env for local development. In production these live only on the
# API's own host (Railway/Fly/Render/etc.) — never in the Vercel dashboard
# project, and never prefixed NEXT_PUBLIC_.

# Postgres connection string (Supabase or otherwise).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Supabase project URL and anon key, if the API talks to Supabase directly
# rather than only through DATABASE_URL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Port the Fastify server listens on.
PORT=4000

# Shared admin key. Must match ADMIN_API_KEY in the dashboard's environment.
ADMIN_API_KEY=your-admin-api-key

# Used by the Intent Contract compiler (compile-intent route).
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
