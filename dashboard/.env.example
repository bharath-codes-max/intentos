# Dashboard environment variables.
# All of these are read on the Next.js SERVER only (Server Components / Server
# Actions — see the `import "server-only"` guard in src/lib/api.ts). None of
# them are exposed to the browser, so none should ever be prefixed
# NEXT_PUBLIC_. Copy this file to .env.local for local development, and add
# the same names in Vercel → Project Settings → Environment Variables for
# Production/Preview.

# Base URL of the deployed Intentos API (Fastify backend). No trailing slash.
API_BASE_URL=https://your-intentos-api.example.com

# Shared admin key the dashboard sends as `x-admin-key` when calling the API.
# Must match ADMIN_API_KEY configured on the API host.
ADMIN_API_KEY=your-admin-api-key

# Org (company) ID the dashboard operates against by default, used until a
# user picks another org via the org switcher.
DEFAULT_ORG_ID=your-default-org-uuid
